#let _calc-ids = calcs.map(c => c.id)

#let calc(..ids) = {
  let xs = ids.pos()
  for x in xs { assert(x in _calc-ids, message: "unknown computation " + x) }
  [\[]
  xs.map(x => link(label("calc-" + x), x)).join(", ")
  [\]]
}

#let calc-table() = {
  block(above: 0.8em, below: 0.4em, text(size: 0.92em, [Table 11. Computations and code. References such as \[C1\] in the text point to the rows of this table.]))
  table(columns: (auto, 1fr, auto), align: (left, left, right),
    table.header([ID], [computation and code], [CPU time]),
    ..calcs.map(c => (
      [#c.id #label("calc-" + c.id)],
      {
        c.en
        linebreak()
        text(size: 0.8em, c.files.map(f => raw(f)).join(linebreak()))
      },
      c.time,
    )).flatten()
  )
}
